<header class="homepage-no-shadow transition-shadows py-5 px-4 sm:py-7 relative z1">
  <div class="flex flex-wrap lg:items-center row w-full justify-between max-w-screen-2xl mx-auto gap-2">

    <a href="/" class="relative flex items-center gap-4 mx-3 mb-2 {{ @resource.data.homepage && 'hidden lg:flex' }}">
      <div class="flex flex-shrink-0 items-center delay-75 w-[3em] h-[3em] absolute left-[1rem]">
        <img src="/images/zen-circle-grunge-brush-stroke-2.png" class="flex-shrink-0 w-[3em] h-[3em]"/>
      </div>
      <div class="flex text-4xl tracking-tighter">
        <span class="font-bold">n         nduality</span>
        <span class="">.</span>
        <span class="">today</span>
      </div>
    </a>

    {% if homepage? %}
      {%@ Button href: "https://ig.me/m/nofinsfreediving", icon: "map/compass-3-fill", target: "_blank" do %}
        I want to go
      {% end %}
    {% else %}
      {%@ Button href: "/book", icon: "document/file-text-fill" do %}
        The Book
      {% end %}
    {% end %}
  </div>
</header>
